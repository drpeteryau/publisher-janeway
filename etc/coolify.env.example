# Environment variables to set in Coolify (Resource -> Environment Variables).
JANEWAY_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(50))"
DB_PASSWORD=
DB_NAME=janeway
DB_USER=janeway

# Public hostname(s) exposed by the Cloudflare Tunnel (comma separated)
JANEWAY_ALLOWED_HOSTS=journals.example.org
JANEWAY_CSRF_TRUSTED_ORIGINS=https://journals.example.org
JANEWAY_DEFAULT_HOST=https://journals.example.org

# First-boot install. PRESS_DOMAIN must equal the public hostname.
JANEWAY_PRESS_NAME=My Press
JANEWAY_PRESS_DOMAIN=journals.example.org
JANEWAY_PRESS_CONTACT=admin@example.org
JANEWAY_JOURNAL_CODE=journal
JANEWAY_JOURNAL_NAME=My Journal
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.org
